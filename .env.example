PORT=3000
RUNTIME_OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RUNTIME_LOG_DIR=./logs

# Agent orchestration
# agent_first: launch mode; model owns conversation/recovery while deterministic Runtime owns external truth and writes
# legacy: rollback-only compatibility mode
RUNTIME_AGENT_MODE=agent_first
# Used only in agent_first mode. Valid range: 2-12. Defaults to 6 when unset/invalid.
RUNTIME_AGENT_MAX_MODEL_CALLS=6
# Agent-first semantic memory inactivity boundary. Old dialogue/task/person context is hidden
# from the model after this many hours; deterministic Runtime state remains durable/private.
RUNTIME_SEMANTIC_CONTEXT_TTL_HOURS=24

# Security
RUNTIME_API_KEY=
RUNTIME_HOST=127.0.0.1
NODE_ENV=production
RUNTIME_DEBUG_RESPONSE=false

# Telegram native adapter (optional, omit to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CLINIC_CODE=clinic_1

# WhatsApp Cloud API transport (optional, omit WHATSAPP_ACCESS_TOKEN to disable)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v19.0
WHATSAPP_CLINIC_ID=

# ClinicCard CRM integration
CLINICCARD_API_BASE_URL=https://cliniccards.com
CLINICCARD_API_TOKEN=
CLINICCARD_DEFAULT_DOCTOR_ID=
CLINICCARD_DEFAULT_CABINET_ID=
CLINICCARD_TIMEZONE=Europe/Prague

# Booking execution mode
# disabled: no booking writes
# shadow: exercise the path without live ClinicCard creation
# live: live writes are possible, but only for clinic_ids explicitly listed below
CLINICCARD_BOOKING_MODE=disabled
# Comma-separated clinic_ids permitted to trigger live ClinicCard writes when
# CLINICCARD_BOOKING_MODE=live. Fails closed: empty/unset means no clinic is permitted.
CLINICCARD_LIVE_CLINIC_ALLOWLIST=

# Authoritative clinic-wide availability policy
# Required when Runtime generates availability because ClinicCard does not provide a proven free-slot/schedule API.
# There are intentionally no working-hour defaults: the clinic/operator must confirm this policy.
CLINICCARD_AVAILABILITY_POLICY_CONFIRMED=false
# ISO weekdays, Monday=1 ... Sunday=7. Example only, replace with the clinic's confirmed schedule.
CLINICCARD_WORKING_DAYS=
# Strict HH:MM in the clinic timezone.
CLINICCARD_WORKING_HOURS_START=
CLINICCARD_WORKING_HOURS_END=
# Positive integer start-grid cadence. Must fit within the configured working interval.
CLINICCARD_SLOT_DURATION_MINUTES=
# Must be explicitly present when the availability policy is confirmed.
# Comma-separated YYYY-MM-DD values, or an empty value only when the clinic confirms no closure dates are configured.
CLINICCARD_CLOSED_DATES=

# Authoritative service -> provider/resource/duration + provider schedule mapping
# Both settings are required before a service may authorize a ClinicCard doctor/cabinet/duration.
# Positive availability additionally requires each live service rule to carry an operator-confirmed
# provider availability object. "No visit" alone is never treated as proof that the doctor is working.
# Keep false until every configured rule has been checked against the real clinic setup.
CLINICCARD_SERVICE_RESOURCE_POLICY_CONFIRMED=false
# Non-empty JSON array. Example shape only, replace IDs/durations/aliases/schedule with operator-confirmed clinic data:
# [{"service_key":"consultation","aliases":["consultation","консультация"],"doctor_id":123,"cabinet_id":456,"duration_minutes":30,"availability":{"working_days":[1,2,3,4,5],"working_hours_start":"09:00","working_hours_end":"17:00","closed_dates":[]}}]
CLINICCARD_SERVICE_RESOURCE_RULES_JSON=

# Realtime voice gateway (Twilio Media Streams + ElevenLabs Speech Engine)
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_ENGINE_ID=
RUNTIME_BASE_URL=http://127.0.0.1:3000
VOICE_CLINIC_CODE=clinic_1
VOICE_PORT=3100
VOICE_PUBLIC_BASE_URL=
TWILIO_AUTH_TOKEN=
# Required for deterministic live call transfer through the Twilio Calls API.
TWILIO_ACCOUNT_SID=
# E.164 staff/front-desk destination, for example +420123456789.
VOICE_HUMAN_TRANSFER_NUMBER=
# 32+ random characters. Caller number is HMACed with this secret before it becomes Runtime identity.
# The raw caller number remains ephemeral inside the voice gateway and is never sent to the model.
VOICE_IDENTITY_HMAC_SECRET=
VOICE_FIRST_MESSAGE=Добрый день. Стоматологическая клиника, чем могу помочь?
VOICE_FALLBACK_REPLY=Извините, сейчас не удалось обработать запрос. Пожалуйста, повторите ещё раз.
# Local development only. Never enable in production.
VOICE_ALLOW_INSECURE_DEV=false
