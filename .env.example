PORT=3000
RUNTIME_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RUNTIME_LOG_DIR=./logs

# Security
RUNTIME_API_KEY=
RUNTIME_HOST=127.0.0.1
NODE_ENV=production
RUNTIME_DEBUG_RESPONSE=false

# Telegram native adapter (optional — omit to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CLINIC_CODE=clinic_1

# ClinicCard CRM integration
CLINICCARD_API_BASE_URL=https://cliniccards.com
CLINICCARD_API_TOKEN=
CLINICCARD_DEFAULT_DOCTOR_ID=
CLINICCARD_DEFAULT_CABINET_ID=
CLINICCARD_TIMEZONE=Europe/Prague
CLINICCARD_BOOKING_MODE=disabled
